  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Target Variable Analysis\n",
    "\n",
    "### 2.1 Target Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Target variable analysis\n",
    "target = df['estimated_lifetime_value']\n",
    "\n",
    "print(\"Target Variable Statistics:\")\n",
    "print(f\"  Mean: {target.mean():.2f}\")\n",
    "print(f\"  Median: {target.median():.2f}\")\n",
    "print(f\"  Std Dev: {target.std():.2f}\")\n",
    "print(f\"  Min: {target.min():.2f}\")\n",
    "print(f\"  Max: {target.max():.2f}\")\n",
    "print(f\"  Range: {target.max() - target.min():.2f}\")\n",
    "print(f\"  Skewness: {stats.skew(target):.4f}\")\n",
    "print(f\"  Kurtosis: {stats.kurtosis(target):.4f}\")\n",
    "\n",
    "# Quartile analysis\n",
    "quartiles = target.quantile([0.25, 0.5, 0.75])\n",
    "print(f\"\\n  Q1 (25%): {quartiles[0.25]:.2f}\")\n",
    "print(f\"  Q2 (50%): {quartiles[0.5]:.2f}\")\n",
    "print(f\"  Q3 (75%): {quartiles[0.75]:.2f}\")\n",
    "print(f\"  IQR: {quartiles[0.75] - quartiles[0.25]:.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.2 Target Distribution Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create multi-panel visualization of target distribution\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Histogram\n",
    "axes[0, 0].hist(target, bins=50, color='steelblue', edgecolor='black', alpha=0.7)\n",
    "axes[0, 0].set_xlabel('Estimated Lifetime Value')\n",
    "axes[0, 0].set_ylabel('Frequency')\n",
    "axes[0, 0].set_title('Distribution of Target Variable (CLV)')\n",
    "axes[0, 0].axvline(target.mean(), color='red', linestyle='--', linewidth=2, label=f'Mean: {target.mean():.2f}')\n",
    "axes[0, 0].axvline(target.median(), color='green', linestyle='--', linewidth=2, label=f'Median: {target.median():.2f}')\n",
    "axes[0, 0].legend()\n",
    "\n",
    "# Log-transformed histogram\n",
    "axes[0, 1].hist(np.log1p(target), bins=50, color='coral', edgecolor='black', alpha=0.7)\n",
    "axes[0, 1].set_xlabel('Log(1 + Estimated Lifetime Value)')\n",
    "axes[0, 1].set_ylabel('Frequency')\n",
    "axes[0, 1].set_title('Distribution of Log-Transformed Target')\n",
    "\n",
    "# Q-Q plot\n",
    "stats.probplot(target, dist=\"norm\", plot=axes[1, 0])\n",
    "axes[1, 0].set_title('Q-Q Plot: Normality Assessment')\n",
    "\n",
    "# Box plot\n",
    "axes[1, 1].boxplot(target, vert=True)\n",
    "axes[1, 1].set_ylabel('Estimated Lifetime Value')\n",
    "axes[1, 1].set_title('Box Plot: Outlier Detection')\n",
    "axes[1, 1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('target_distribution.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"Target distribution plot saved as 'target_distribution.png'\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.3 Outlier Detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify outliers using IQR method\n",
    "Q1 = target.quantile(0.25)\n",
    "Q3 = target.quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "outliers = target[(target < lower_bound) | (target > upper_bound)]\n",
    "print(f\"Outliers detected (IQR method):\")\n",
    "print(f\"  Lower bound: {lower_bound:.2f}\")\n",
    "print(f\"  Upper bound: {upper_bound:.2f}\")\n",
    "print(f\"  Number of outliers: {len(outliers)} ({100*len(outliers)/len(target):.1f}%)\")\n",
    "\n",
    "# Z-score based outlier detection\n",
    "z_scores = np.abs(stats.zscore(target))\n",
    "outliers_zscore = np.sum(z_scores > 3)\n",
    "print(f\"\\nOutliers detected (Z-score > 3):\")\n",
    "print(f\"  Number of outliers: {outliers_zscore} ({100*outliers_zscore/len(target):.1f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
