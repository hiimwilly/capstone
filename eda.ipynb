   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature definitions\n",
    "feature_descriptions = {\n",
    "    'total_purchase_count': 'Total number of purchases made by customer',\n",
    "    'average_order_value': 'Mean value of customer orders',\n",
    "    'days_since_first_purchase': 'Days elapsed from first purchase to present',\n",
    "    'days_since_last_purchase': 'Days elapsed from most recent purchase to present (recency)',\n",
    "    'product_category_diversity': 'Normalized measure of product category variety (0-1)',\n",
    "    'loyalty_program_membership': 'Categorical: Enrolled or Not Enrolled in loyalty program',\n",
    "    'estimated_lifetime_value': 'TARGET: Estimated customer lifetime value (CLV)'\n",
    "}\n",
    "\n",
    "print(\"Feature Descriptions:\")\n",
