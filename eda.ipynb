    "print(f\"R² Improvement: {(r2_poly - r2_linear):.6f} ({100*(r2_poly - r2_linear)/r2_linear:.2f}%)\")\n",
    "\n",
    "if (r2_poly - r2_linear) / r2_linear > 0.05:\n",
    "    print(\"\\nConclusion: STRONG evidence of nonlinearity (>5% improvement)\")\n",
    "elif (r2_poly - r2_linear) / r2_linear > 0.02:\n",
    "    print(\"\\nConclusion: MODERATE evidence of nonlinearity (>2% improvement)\")\n",
    "else:\n",
    "    print(\"\\nConclusion: Limited evidence of nonlinearity\")"
