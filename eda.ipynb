  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Interaction and Nonlinearity Analysis\n",
    "\n",
    "### 5.1 Feature Interactions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze pairwise interactions\n",
    "print(\"Interaction Analysis:\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Calculate interaction terms and their correlation with target\n",
    "interactions = []\n",
    "\n",
    "for i in range(len(continuous_features)):\n",
    "    for j in range(i+1, len(continuous_features)):\n",
    "        feat1 = continuous_features[i]\n",
    "        feat2 = continuous_features[j]\n",
    "        \n",
    "        # Multiplicative interaction\n",
    "        interaction_term = df[feat1] * df[feat2]\n",
    "        corr_with_target = interaction_term.corr(df['estimated_lifetime_value'])\n",
    "        \n",
    "        interactions.append({\n",
    "            'interaction': f\"{feat1} × {feat2}\",\n",
    "            'correlation': abs(corr_with_target),\n",
    "            'signed_correlation': corr_with_target\n",
    "        })\n",
    "\n",
    "# Sort by absolute correlation\n",
    "interactions_df = pd.DataFrame(interactions).sort_values('correlation', ascending=False)\n",
    "\n",
    "print(\"Top 10 Feature Interactions (by absolute correlation with target):\")\n",
    "print(interactions_df.head(10).to_string(index=False))"
   ]
  },
  {
   "cell_type": {"cell_type": "markdown",
   "metadata": {},
   "source": [
    "    "
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5.2 Nonlinearity Assessment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test nonlinearity by comparing linear vs polynomial relationships\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score\n",
    "\n",
    "# Prepare data\n",
    "X_continuous = df[continuous_features].values\n",
    "y = df['estimated_lifetime_value'].values\n",
    "\n",
    "# Linear regression baseline\n",
    "lr_linear = LinearRegression()\n",
    "lr_linear.fit(X_continuous, y)\n",
    "y_pred_linear = lr_linear.predict(X_continuous)\n",
    "r2_linear = r2_score(y, y_pred_linear)\n",
    "\n",
    "# Polynomial regression (degree 2)\n",
    "poly_features = PolynomialFeatures(degree=2, include_bias=False)\n",
    "X_poly = poly_features.fit_transform(X_continuous)\n",
    "lr_poly = LinearRegression()\n",
    "lr_poly.fit(X_poly, y)\n",
    "y_pred_poly = lr_poly.predict(X_poly)\n",
    "r2_poly = r2_score(y, y_pred_poly)\n",
    "\n",
